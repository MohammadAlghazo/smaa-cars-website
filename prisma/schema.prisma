generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model ContactMessage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  
  type      String   
  name      String
  phone     String
  email     String?
  city      String?

  
  carType      String?
  carModel     String?
  carCategory  String?
  carColor     String?
  budget       String?
  notes        String? 

  
  companyName  String?
  managerName  String?
  activityType String?
  carQuantity  String?

  
  applicantName     String?
  jobTitle          String?
  country           String?
  collaborationType String?
  companyBio        String?
  proposalDetails   String?

  
  complaintType   String? 
  orderNumber     String?
  complaintTitle  String?
  requiredAction  String?
}

model Car {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  name         String
  brand        String
  modelYear    String
  mileage      String
  price        String?
  description  String   
  mainImage    String
  images       String   
  features     String   
  isAvailable  Boolean  @default(true)
}

model Article {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  title        String
  slug         String   @unique
  excerpt      String
  content      String   
  coverImage   String
  author       String   @default("SMAA CARS")
  isPublished  Boolean  @default(true)
}

model AdminUser {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  username     String   @unique
  passwordHash String
}
